[Unit]
Description=IT490 Cocktail Backend
After=network.target

[Service]
Type=simple
User=befe
WorkingDirectory=/home/befe/Capstone-Group-01/milestone3/be/CocktailBackend
ExecStart=/usr/bin/dotnet /home/befe/cocktail-publish/CocktailBackend.dll
Environment=ASPNETCORE_ENVIRONMENT=Development
Environment=RABBITMQ_HOST=100.100.36.22
Environment=RABBITMQ_USER=bigboss
Environment=RABBITMQ_PASSWORD=secure
EnvironmentFile=/etc/cocktail-backend.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
